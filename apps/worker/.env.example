APP_NAME=auto-search-worker
APP_ENV=dev
DEBUG=true

BOT_API_BASE_URL=http://bot-api:8100
BOT_API_PREFIX=/api/v1
BOT_API_TIMEOUT_SEC=20

SEARCH_API_BASE_URL=http://auto-search-api:8000
SEARCH_API_PREFIX=/api/v1
SEARCH_API_TIMEOUT_SEC=20
SEARCH_API_KEY=

TELEGRAM_BOT_TOKEN=
