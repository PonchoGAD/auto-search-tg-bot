APP_NAME=auto-search-bot-api
APP_ENV=dev
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8100

BOT_API_PREFIX=/api/v1
BOT_INTERNAL_PREFIX=/internal

DATABASE_URL=postgresql+psycopg2://auto:postgres@postgres:5432/auto_search_bot

SEARCH_API_BASE_URL=http://auto-search-api:8000
SEARCH_API_PREFIX=/api/v1
SEARCH_API_KEY=
SEARCH_API_TIMEOUT_SEC=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

INTERNAL_API_KEY=change-me-in-env
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

DEFAULT_CURRENCY=RUB
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

FREE_DAILY_SEARCH_LIMIT=25
FREE_SAVED_SEARCHES_LIMIT=3
FREE_FAVORITES_LIMIT=50

ADMIN_TELEGRAM_IDS_RAW=

CORS_ORIGINS_RAW=*

PAYMENT_PROVIDER=stub
PAYMENT_RETURN_URL=
PAYMENT_WEBHOOK_SECRET=

ALERTS_BATCH_SIZE=100
ALERTS_MATCH_LIMIT_PER_SEARCH=30   